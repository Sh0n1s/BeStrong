# backend.hcl.example — committed documentation of the azurerm backend
# partial-config shape.
#
# The CI pipeline supplies these values directly to `terraform init` via the
# pipeline task inputs. For local runs, copy this file (values from the
# bootstrap outputs) and pass it with:
#   terraform -chdir=terraform/stack init -backend-config="<path to your copy>"
# Local backend auth: ARM_ACCESS_KEY environment variable
#   (az storage account keys list -g rg-bestrong-tfstate --account-name <name>).

resource_group_name  = "rg-bestrong-tfstate" # bootstrap-created state RG
storage_account_name = "sttfstateabc123"     # bootstrap-created account (sttfstate<suffix>)
container_name       = "tfstate"
key                  = "bestrong/dev/terraform.tfstate"
