# backend.hcl.example — committed documentation of the azurerm backend
# partial-config shape.
#
# The REAL file is generated by scripts/deploy.ps1 into .session/backend.hcl
# (gitignored) from bootstrap outputs every sandbox session — never
# hand-maintain a real copy of this file.
#
# Usage: terraform -chdir=terraform/stack init -backend-config="../../.session/backend.hcl"
# Backend auth: ARM_ACCESS_KEY environment variable, set by deploy.ps1.

resource_group_name  = "1-xxxxxxxx-playground-sandbox" # playground RG (hosts the state storage account)
storage_account_name = "sttfstateabc123"               # bootstrap-created account (sttfstate<suffix>)
container_name       = "tfstate"
key                  = "bestrong/dev/terraform.tfstate"
