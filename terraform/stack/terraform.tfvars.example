# terraform.tfvars.example — committed template of human-set inputs for
# terraform/stack. Copy to terraform.tfvars (gitignored) only if you need
# to override defaults.
#
# In CI, subscription/auth come from the Azure service connection and
# deployer_ip is discovered per run (the hosted agent's public IP) — nothing
# below is required for pipeline runs.

# --- Environment inputs ---
subscription_id     = "00000000-0000-0000-0000-000000000000" # optional; omit to use ARM_SUBSCRIPTION_ID
resource_group_name = "rg-bestrong-dev"                      # created by the stack
deployer_ip         = "203.0.113.10"                         # public IP allowed through KV/SQL/Storage firewalls

# --- Feature flags ---
enable_application_insights = true  # App Insights on by default
enable_sql_private_endpoint = false # optional Private Link demo for SQL
enable_app_identity         = false # legacy-off default; safe to enable in a personal subscription

# --- Sizing / operational knobs (safe defaults live in variables.tf) ---
# location            = "centralus"
# image_tag           = "v1"
# app_service_sku     = "B1"
# sql_database_sku    = "Basic"
# file_share_quota_gb = 100
# log_retention_days  = 30
